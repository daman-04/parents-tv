<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer on SurfaceView for high-speed hardware decoding -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Center Buffering / Loading Spinner -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible" />

    <!-- Offline Notification Banner (Top Right, safe margin) -->
    <LinearLayout
        android:id="@+id/offline_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/error_banner_background"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/offline_banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Internet Connection • Using Saved Channels"
            android:textColor="@color/status_warning"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Left Channel Info Card (shown for 3.5s on channel change) -->
    <LinearLayout
        android:id="@+id/channel_info_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/banner_background"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:elevation="8dp">

        <!-- Channel Logo -->
        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:background="#262626"
            android:contentDescription="Channel Logo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channel_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="CH 1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channel_new_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="#1565C0"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="NEW"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/channel_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="PUNJABI LIVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DD Punjabi"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remote_hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="▲ Previous  •  ▼ Next Channel  •  OK Channel Menu"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error Banner Card (shown when all stream links fail) -->
    <LinearLayout
        android:id="@+id/error_banner_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/error_banner_background"
        android:minWidth="540dp"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel Not Working"
            android:textColor="@color/status_error"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Switching to next channel in 5 seconds..."
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Press ▲ or ▼ to switch now"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

</FrameLayout>
