<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer on SurfaceView for high-speed hardware decoding -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Center Buffering / Loading Spinner -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible" />

    <!-- Bottom Left Channel Info Card (shown for 3s on channel change) -->
    <LinearLayout
        android:id="@+id/channel_info_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/banner_background"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="20dp"
        android:paddingEnd="36dp"
        android:paddingBottom="20dp"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/channel_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_background"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="CH 1"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/channel_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="PUNJABI LIVE"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DD Punjabi"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remote_hints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="▲ Previous  •  ▼ Next Channel  •  OK Channel Menu"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Error Banner Card (shown when a stream fails) -->
    <LinearLayout
        android:id="@+id/error_banner_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/error_banner_background"
        android:minWidth="520dp"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel Not Working"
            android:textColor="@color/status_error"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Switching to next channel in 5 seconds..."
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Press ▲ or ▼ to switch now"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

</FrameLayout>
