<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:keepScreenOn="true">

    <!-- Media3 ExoPlayer on SurfaceView for high-speed hardware decoding -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="surface_view"
        app:use_controller="false"
        app:resize_mode="fit" />

    <!-- Center Buffering / Loading Spinner -->
    <ProgressBar
        android:id="@+id/loading_indicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible" />

    <!-- Offline Notification Banner (Top Right, safe margin) -->
    <LinearLayout
        android:id="@+id/offline_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/error_banner_background"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/offline_banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Internet Connection • Using Saved Channels"
            android:textColor="@color/status_warning"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Left Channel Info Card (shown for 3.5s on channel change) -->
    <LinearLayout
        android:id="@+id/channel_info_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/banner_background"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:elevation="8dp">

        <!-- Channel Logo -->
        <ImageView
            android:id="@+id/channel_logo"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="20dp"
            android:background="#262626"
            android:contentDescription="Channel Logo"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/channel_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_background"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="CH 1"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channel_new_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="#1565C0"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="NEW"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/channel_favorite_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="★ FAVORITE"
                    android:textColor="#FFD700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/channel_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="PUNJABI LIVE"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="PTC Simran"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remote_hints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="▲▼ Next/Prev  •  ◀ Recall  •  ▶ Favorites  •  ☰ Options  •  OK Menu"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Error Banner Card (shown when all stream links fail) -->
    <LinearLayout
        android:id="@+id/error_banner_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/error_banner_background"
        android:minWidth="540dp"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="28dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Channel Not Working"
            android:textColor="@color/status_error"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/error_countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Switching to next channel in 5 seconds..."
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Press ▲ or ▼ to switch now"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- FULL TV CHANNEL OVERLAY MENU (Step 7: Remote Grid/List)   -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/channel_menu_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E60D0D0D"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- Top Header: Logo / Search / View Mode / Aspect Ratio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TV"
                android:textColor="@color/accent_red"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Search Input Box -->
            <EditText
                android:id="@+id/search_input"
                android:layout_width="380dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/search_box_background"
                android:hint="🔍 Search (hold mic on remote)..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#888888"
                android:textSize="18sp"
                android:maxLines="1"
                android:nextFocusDown="@+id/channels_recycler_view"
                android:nextFocusRight="@+id/btn_aspect_ratio" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Aspect Ratio Button -->
            <TextView
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/pill_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="📐 Aspect: Fit"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Edit Channel Order Button -->
            <TextView
                android:id="@+id/btn_edit_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/pill_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="↕ Edit Order"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Grid / List View Toggle Button -->
            <TextView
                android:id="@+id/btn_toggle_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_focus_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="☷ Grid View"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Reorder Mode Instructions Banner -->
        <TextView
            android:id="@+id/reorder_mode_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#2E7D32"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="↕ REORDER MODE: Highlight a channel, press OK to grab, use ▲/▼ to move, press OK to place"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Category / Language Tabs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/category_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal" />

        <!-- Channels Grid / List -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channels_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <!-- Empty Search Results Text -->
            <TextView
                android:id="@+id/empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No channels found. Try another search or category."
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Remote Key Hints Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="▲▼◀▶ Navigate  •  OK Watch  •  Hold OK ★ Toggle Favorite  •  BACK Return to Video"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- QUICK OPTIONS MODAL DIALOG (3-Lines Remote Menu Button)  -->
    <!-- ======================================================== -->
    <FrameLayout
        android:id="@+id/quick_options_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <include
            android:id="@+id/dialog_quick_options"
            layout="@layout/dialog_quick_options"
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- ======================================================== -->
    <!-- IN-APP UPDATE MODAL DIALOG (Prompt & Download Progress)   -->
    <!-- ======================================================== -->
    <FrameLayout
        android:id="@+id/update_dialog_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="540dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_background"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/tv_update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 New TV App Update Available"
                android:textColor="@color/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Version 1.1.0 available"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_update_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#22222B"
                android:padding="12dp"
                android:text="• Auto update directly over app\n• Fast channel surfing\n• 1,466 channels with English and Sports"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- Progress Bar (shown when downloading) -->
            <LinearLayout
                android:id="@+id/layout_update_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pb_update_download"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/accent" />

                <TextView
                    android:id="@+id/tv_update_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Downloading update: 0%..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:id="@+id/layout_update_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_update_later"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/card_focus_selector"
                    android:text="Later"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btn_update_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_focus_selector"
                    android:text="⬇ Update Now"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
