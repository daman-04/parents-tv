<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Luminous Apple White Glass Surface with Crisp Depth -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#F6F8FC" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Selected: Accent Red Frosted Rim for currently playing channel -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#38E53935" />
            <stroke android:width="2dp" android:color="#FF5252" />
        </shape>
    </item>

    <!-- Default: Translucent Frosted Glass with Specular Hairline Highlight -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1.2dp" android:color="#28FFFFFF" />
        </shape>
    </item>
</selector>
