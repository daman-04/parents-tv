<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Luminous Solid White Focus Surface -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Normal: Frosted Glass Capsule Tile with Specular Rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="135"
                android:startColor="#451D273F"
                android:endColor="#2B131B2E"
                android:type="linear" />
            <stroke android:width="1.2dp" android:color="#47FFFFFF" />
        </shape>
    </item>
</selector>
