<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Vibrant Apple Accent with Clean White Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#E53935" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- Selected Category: Active Frosted Slate with Glowing Accent Underline/Stroke -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#40FFFFFF" />
            <stroke android:width="2dp" android:color="#FF5252" />
        </shape>
    </item>

    <!-- Normal: Translucent Liquid Glass Capsule -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1.2dp" android:color="#28FFFFFF" />
        </shape>
    </item>
</selector>
